---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";

const work = (await getCollection("work", ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);

// PLACEHOLDER: replace with your real numbers — not invented, left blank on purpose.
const stats = [
  { value: "—", label: "Years in fintech" },
  { value: "—", label: "Shipped products" },
  { value: "—", label: "Teams led" },
];
---

<Base title="Razi">
  <section class="hero">
    <h1>Razi</h1>
    <p class="hero__positioning">
      Staff Product Designer, AI interfaces for fintech.
    </p>
    <dl class="hero__stats">
      {
        stats.map((stat) => (
          <div class="hero__stat">
            <dt class="tabular hero__stat-value">{stat.value}</dt>
            <dd class="hero__stat-label">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="work" aria-label="Selected work">
    <ul class="work__list">
      {
        work.map((entry) => (
          <li class="work__item">
            <a href={`/work/${entry.id}/`} class="work__link">
              <div class="work__thumb">
                <Image
                  src={entry.data.thumbnail}
                  alt=""
                  width={480}
                  height={360}
                />
              </div>
              <div class="work__content">
                <div class="work__link-top">
                  <h2 class="work__title">{entry.data.title}</h2>
                  <span class="tabular work__year">{entry.data.year}</span>
                </div>
                <p class="work__summary">{entry.data.summary}</p>
                <p class="work__outcome">
                  <span class="tabular work__outcome-value">
                    {entry.data.outcome.value}
                  </span>
                  <span class="work__outcome-label">
                    {entry.data.outcome.label}
                  </span>
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/work/" class="work__all-link">All work &rarr;</a>
  </section>

  <a href="/headroom/" class="building">
    <span class="building__dot" aria-hidden="true"></span>
    Currently building Headroom
  </a>

  <section class="contact">
    <!-- PLACEHOLDER: replace with your real contact line -->
    <p>Open to conversations — reach out via the links above.</p>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .hero__positioning {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    max-width: 34ch;
  }

  .hero__stats {
    display: flex;
    gap: var(--space-6);
    margin: 0;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__stat-value {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin: 0;
  }

  .hero__stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .work {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
  }

  .work__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .work__item + .work__item {
    border-top: 1px solid var(--color-border);
  }

  .work__link {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    padding-block: var(--space-5);
  }

  .work__thumb {
    flex: 0 0 128px;
    width: 128px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
  }

  .work__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__content {
    flex: 1;
    min-width: 0;
  }

  .work__link-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .work__title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }

  .work__year {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .work__summary {
    color: var(--color-text-muted);
    margin: var(--space-2) 0 var(--space-3);
    max-width: 52ch;
  }

  .work__outcome {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }

  .work__outcome-value {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .work__outcome-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-6);
    color: var(--color-text-muted);
  }

  .work__all-link {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .work__all-link:hover {
    color: var(--color-text);
  }

  .building {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    width: fit-content;
  }

  .building:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .building__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: building-pulse 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .building__dot {
      animation: none;
    }
  }

  @keyframes building-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: var(--space-6) var(--space-5);
    }

    .hero__stats {
      flex-wrap: wrap;
      row-gap: var(--space-4);
    }

    .work__link {
      flex-direction: column;
    }

    .work__thumb {
      width: 100%;
      flex: none;
      aspect-ratio: 16 / 9;
    }
  }
</style>
